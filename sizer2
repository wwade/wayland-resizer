#!/bin/bash
# Window resizing tool for GNOME Wayland
# Requires the GNOME Shell extension to be installed and enabled

all_workspaces="false"

while [[ $# -gt 0 ]]; do
    case $1 in
        -a|--all)
            all_workspaces="true"
            shift
            ;;
        -h|--help)
            echo "Usage: sizer2 [OPTIONS]"
            echo "Resize and position windows according to screen resolution."
            echo ""
            echo "Options:"
            echo "  -a, --all     Process windows across all workspaces"
            echo "  -h, --help    Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Use --help for usage information" >&2
            exit 1
            ;;
    esac
done

gdbus call --session \
    --dest org.gnome.Shell.Extensions.WindowSizer \
    --object-path /org/gnome/Shell/Extensions/WindowSizer \
    --method org.gnome.Shell.Extensions.WindowSizer.ResizeWindows \
    "$all_workspaces"
